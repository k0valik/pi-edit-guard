{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "extension.ts", "packages/pi-base/src/**/*.ts"],
  "exclude": ["node_modules", "**/node_modules", "**/dist", "tests/integration/fixtures/files"]
}
